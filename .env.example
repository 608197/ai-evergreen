# Copy to .env and fill in real values locally. Never commit .env itself.
# .env is already excluded via .gitignore.

# --- AWS Bedrock / AgentCore (primary spike platform) -----------------------
AWS_REGION=us-east-1
AWS_PROFILE=ai-evergreen-sandbox
BEDROCK_CURRENT_MODEL_ID=REPLACE_WITH_PINNED_MODEL_ID
BEDROCK_CANDIDATE_MODEL_ID=REPLACE_WITH_PINNED_MODEL_ID
BEDROCK_JUDGE_MODEL_ID=REPLACE_WITH_PINNED_MODEL_ID

# --- Second provider adapter (real or simulator) ----------------------------
SECOND_PROVIDER_MODE=simulator          # simulator | openai_compatible
SECOND_PROVIDER_API_KEY=
SECOND_PROVIDER_BASE_URL=

# --- Graph / metadata store --------------------------------------------------
GRAPH_BACKEND=networkx                  # networkx | neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
METADATA_DB_URL=sqlite:///./data/metadata.db   # or postgresql://... for Postgres 16

# --- Test asset adapters (spike defaults to mock fixtures) ------------------
JIRA_ADAPTER_MODE=mock                  # mock | live
JIRA_BASE_URL=
JIRA_API_TOKEN=
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=

# --- Evidence store -----------------------------------------------------------
EVIDENCE_STORE_BACKEND=local            # local | s3
EVIDENCE_S3_BUCKET=
EVIDENCE_LOCAL_PATH=./evidence_store

# --- Observability --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ai-evergreen-spike

# --- Cost guardrails (see docs/Risks.md) --------------------------------------
DAILY_CLOUD_BUDGET_USD=25
PER_EVENT_TOKEN_BUDGET=200000
