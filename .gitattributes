# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.env* text eol=lf
Dockerfile text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf

# Binary files
*.png binary
*.jpg binary
*.db binary
*.sqlite binary
*.sqlite3 binary
